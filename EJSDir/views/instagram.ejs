<%- include("includes/head.ejs") %>

<body>
    <h2>This page belongs to @<%= data.name  %> 
    </h2>
    <button>Follow</button>
    <button>Message</button>

    <p>Following : <%= data.following %> &nbsp; &nbsp; &nbsp; Followers : <%= data.followers %></p><hr>

    <% for(let post of data.posts ) { %>
        <img src="<%= post.image %>" alt="some img" style="height: 100px;">
        <p>
            Likes: <%= post.likes %> &nbsp; &nbsp; &nbsp; &nbsp; Comments: <%= post.comments %> <br>
        </p>
    <% } %>
</body>

</html>
