<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View post in details</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h2>@<%= post.username %></h2>
    <h4>Post's id : <%=post.id%></h4>
    <p><%= post.content %></p>
    <img class="img" src="/<%=post.image%>" alt="Car image"><br><br>
    <p>Upload date : <%=post.date%>
</body>
</html>